# ===================================================================
# DIGITAL MARKETPLACE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env and configure all secrets for your environment.
# SECURITY NOTICE: Never commit real credentials, production secrets, or private keys to git.

# -------------------------------------------------------------------
# Application Runtime & URLs
# -------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
# Canonical public URL (only NEXT_PUBLIC_* variables are exposed to client browser bundle)
NEXT_PUBLIC_APP_URL="https://marketplace.yourdomain.com"

# -------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------
# Recommended for production: use SSL connection pooling (PgBouncer, AWS RDS Proxy, Supabase, Neon)
# Syntax: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=require&pgbouncer=true&connection_limit=20
DATABASE_URL="postgresql://marketplace_user:strong_production_password@localhost:5432/digital_marketplace?schema=public&sslmode=require"

# -------------------------------------------------------------------
# Authentication & Cryptographic Signing
# -------------------------------------------------------------------
# Must be a cryptographically random secret of at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET="your-strong-production-jwt-secret-minimum-32-chars-long"

# Secret used to sign time-limited 15-minute file download URLs (falls back to JWT_SECRET if unset)
DOWNLOAD_SIGNING_SECRET="your-secure-download-signing-hmac-secret-32-chars"

# -------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -------------------------------------------------------------------
# Public Razorpay key ID (can be shared with client-side checkout SDK)
RAZORPAY_KEY_ID="rzp_live_your_production_key_id"
# Secret Razorpay key (NEVER expose to frontend, git, or client responses)
RAZORPAY_KEY_SECRET="your_production_razorpay_secret"
# Webhook secret for verifying cryptographic HMAC-SHA256 signatures on incoming server webhooks
RAZORPAY_WEBHOOK_SECRET="your_production_webhook_secret"
# Set to "true" ONLY in local testing to bypass live Razorpay API calls
MOCK_PAYMENTS="false"

# -------------------------------------------------------------------
# Private Object Storage (Cloudflare R2 / AWS S3)
# -------------------------------------------------------------------
# Storage provider: "local" (development filesystem) | "r2" (Cloudflare R2) | "s3" (AWS S3)
STORAGE_PROVIDER="r2"

# Maximum upload file size in bytes. Default: 524288000 (500 MB)
MAX_UPLOAD_SIZE_BYTES="524288000"

# S3 / Cloudflare R2 Credentials & Endpoint
# Note: For Cloudflare R2, endpoint format is: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_BUCKET="marketplace-private-assets"
STORAGE_ACCESS_KEY="your-storage-access-key-id"
STORAGE_SECRET_KEY="your-storage-secret-access-key"
STORAGE_REGION="auto"

# Legacy/alternative R2 environment variable aliases (supported by S3StorageProvider)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-storage-access-key-id"
R2_SECRET_ACCESS_KEY="your-storage-secret-access-key"
R2_BUCKET_NAME="marketplace-private-assets"
R2_BUCKET_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# -------------------------------------------------------------------
# CORS & Network Hardening
# -------------------------------------------------------------------
# Comma-separated list of approved frontend origins for CORS.
# No wildcard '*' is allowed in production when credentials are included.
ALLOWED_ORIGINS="https://marketplace.yourdomain.com,https://admin.yourdomain.com"

# -------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------
# Set to "true" to enforce sliding-window rate limiting on sensitive routes.
ENABLE_RATE_LIMITING="true"
