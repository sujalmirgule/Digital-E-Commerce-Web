DATABASE_URL="postgresql://user:password@localhost:5432/digital_marketplace?schema=public"
JWT_SECRET="your-secure-jwt-secret-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# -------------------------------------------------------------------
# Object Storage (Feature 07+)
# -------------------------------------------------------------------

# Storage provider: "local" (development) | "r2" (Cloudflare R2 production)
STORAGE_PROVIDER="local"

# Maximum upload file size in bytes. Default: 524288000 (500 MB)
MAX_UPLOAD_SIZE_BYTES="524288000"

# --- Cloudflare R2 credentials (only required when STORAGE_PROVIDER=r2) ---
# Never commit real credentials. Add your real values to .env (not .env.example).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="marketplace-private-assets"
R2_BUCKET_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
